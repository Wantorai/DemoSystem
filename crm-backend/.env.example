NODE_ENV=development
PORT=5000

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=demo_crm
DB_USER=demo_crm_user
DB_PASSWORD=replace-with-a-strong-password

# Authentication and internal services
JWT_SECRET=replace-with-a-long-random-value
INTERNAL_API_BASE=http://127.0.0.1:5000
INTERNAL_API_SECRET=replace-with-a-long-random-value

# Browser clients allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000
SOCKET_CORS_ORIGINS=http://localhost:3000

# Redis is required by background queues
REDIS_URL=redis://127.0.0.1:6379

# Add variables only for integrations enabled in your environment.
# Never commit their real values.
