# Только для backend. Никогда не добавляйте Access/Secret Key во frontend.
FILESPACE_S3_ENDPOINT=https://s3.example.com
FILESPACE_S3_REGION=example-region-1
FILESPACE_S3_BUCKET=demo-filespace
FILESPACE_S3_FORCE_PATH_STYLE=true
FILESPACE_S3_ACCESS_KEY=
FILESPACE_S3_SECRET_KEY=
# Стабильный случайный секрет для постоянных ссылок вложений из чатов.
# После начала использования менять его нельзя: старые ссылки перестанут работать.
FILESPACE_MEDIA_SECRET=
FILESPACE_SIGNED_URL_TTL=900
# По умолчанию 5 ГБ. Для более крупных файлов будет использоваться multipart upload.
FILESPACE_MAX_FILE_SIZE=5368709120
